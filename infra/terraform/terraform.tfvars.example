# Copy to terraform.tfvars and adjust. It contains no secrets (the session secret is
# generated by Terraform and stored in Key Vault), so it can be committed and used by
# .github/workflows/terraform.yml.

subscription_id = "00000000-0000-0000-0000-000000000000"
location        = "germanywestcentral"
name_prefix     = "infracmdb"
environment     = "prod"
# name_suffix   = "a1b2c3"   # optional fixed suffix instead of a random one

# Everybody who runs `terraform apply`: you + the GitHub Actions Terraform identity.
#   az ad signed-in-user show --query id -o tsv
#   az ad sp show --id <terraform-app-client-id> --query id -o tsv
terraform_principal_object_ids = [
  "00000000-0000-0000-0000-000000000000", # Jane Doe (admin)
  "00000000-0000-0000-0000-000000000000", # GitHub Actions – Terraform
]
# Optional read-only identity used for pull request plans (TF_PLAN_AZURE_CLIENT_ID)
terraform_plan_principal_object_ids = []

# GitHub Actions app deployment identity (deploy.yml) -> "Website Contributor" on the web app
deployment_principal_object_id = null

# --- App Service ---------------------------------------------------------------
app_service_plan_sku          = "P0v3"
app_service_plan_worker_count = 1
# app_base_url                = "https://cmdb.yourdomain.com"   # when a custom domain is bound

# --- Authentication ------------------------------------------------------------
entra_app_display_name = "Infrastruktur CMDB"
entra_require_app_role = true
default_role           = "viewer"
bootstrap_admins       = ["firstname.lastname@yourdomain.com"]

# true needs DelegatedPermissionGrant.ReadWrite.All + Application.Read.All for the CI identity
entra_grant_admin_consent = false

# Optional: groups (object IDs) per app role; needs AppRoleAssignment.ReadWrite.All for the CI identity
entra_app_role_assignments = {
  # "CMDB.Admin"    = ["00000000-0000-0000-0000-000000000000"] # SG-CMDB-Admins
  # "CMDB.Editor"   = ["00000000-0000-0000-0000-000000000000"] # SG-CMDB-Editors
  # "CMDB.Operator" = ["00000000-0000-0000-0000-000000000000"] # SG-CMDB-Operators
  # "CMDB.Viewer"   = ["00000000-0000-0000-0000-000000000000"] # SG-CMDB-Viewers
}

# --- PostgreSQL ----------------------------------------------------------------
postgres_sku_name              = "B_Standard_B1ms"
postgres_storage_mb            = 32768
postgres_backup_retention_days = 14

postgres_entra_admin = {
  object_id = "00000000-0000-0000-0000-000000000000" # az ad group show -g SG-CMDB-PostgreSQL-Admins --query id -o tsv
  name      = "SG-CMDB-PostgreSQL-Admins"
  type      = "Group"
}

postgres_allow_azure_services = true
postgres_firewall_rules = {
  # office-hq = { start_ip_address = "203.0.113.10", end_ip_address = "203.0.113.10" }
}

# Production: private networking (see docs/AZURE.md – changing this later replaces the server)
# app_service_subnet_id        = "/subscriptions/.../subnets/snet-app"
# postgres_delegated_subnet_id = "/subscriptions/.../subnets/snet-postgres"
# postgres_private_dns_zone_id = "/subscriptions/.../privateDnsZones/infracmdb.private.postgres.database.azure.com"

# --- Maps (optional; default: built-in world map without external requests) -----
# map_tile_url         = "https://tiles.yourdomain.com/{z}/{x}/{y}.png"
# map_tile_attribution = "&copy; Your map provider"
