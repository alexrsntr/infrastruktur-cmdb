{
  "name": "infrastruktur-cmdb",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "IT Configuration Management Database (CMDB) for plants, buildings and network/compute infrastructure",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:api",
    "build:web": "vite build",
    "build:api": "esbuild server/index.ts --bundle --platform=node --target=node22 --format=esm --packages=external --sourcemap --outfile=dist/server.mjs",
    "start": "node --enable-source-maps dist/server.mjs",
    "migrate": "tsx --env-file-if-exists=.env server/db/cli.ts migrate",
    "seed": "tsx --env-file-if-exists=.env server/db/cli.ts seed",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "lint": "npm run typecheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@azure/identity": "^4.14.1",
    "@azure/msal-node": "^7.1.2",
    "@azure/storage-blob": "^12.34.0",
    "archiver": "^7.0.1",
    "compression": "^1.8.2",
    "connect-pg-simple": "^10.0.0",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "express-session": "^1.18.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.0",
    "nodemailer": "^10.3.1",
    "papaparse": "^5.5.0",
    "pg": "^8.16.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.1.0",
    "@tanstack/react-query": "^5.90.0",
    "@types/adm-zip": "^0.5.8",
    "@types/archiver": "^6.0.4",
    "@types/compression": "^1.8.1",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.18.2",
    "@types/leaflet": "^1.9.20",
    "@types/mailparser": "^3.9.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.0",
    "@types/papaparse": "^5.3.16",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/smtp-server": "^3.5.13",
    "@types/supertest": "^6.0.3",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^5.0.0",
    "adm-zip": "^0.6.1",
    "antd": "^6.0.0",
    "concurrently": "^9.2.0",
    "dayjs": "^1.11.18",
    "esbuild": "^0.28.2",
    "leaflet": "^1.9.4",
    "mailparser": "^3.14.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "react-router": "^7.9.0",
    "smtp-server": "^3.21.3",
    "supertest": "^7.1.0",
    "topojson-client": "^3.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.1.0",
    "world-atlas": "^2.0.2"
  }
}
