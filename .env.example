# ---------------------------------------------------------------------------
# Infrastruktur CMDB – configuration. Copy to .env for local development.
# On Azure App Service these are set as Application Settings (see docs/AZURE.md).
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
# Public URL of the app (used for the Entra ID redirect URI and logout redirect)
APP_BASE_URL=http://localhost:5173
# Long random string, e.g. `openssl rand -base64 48` (store as Key Vault reference in Azure)
SESSION_SECRET=change-me-to-a-long-random-string

# ---- Authentication --------------------------------------------------------
# entra = Microsoft Entra ID SSO (production) | local = e-mail + password accounts (Docker, small sites) | dev = local login picker (development only)
AUTH_MODE=dev
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# Either a client secret ...
ENTRA_CLIENT_SECRET=
# ... or (recommended, secretless) a managed identity configured as federated credential
# on the app registration. Set to true and (for user-assigned MI) AZURE_CLIENT_ID.
ENTRA_USE_MANAGED_IDENTITY=false
# If true, users without one of the CMDB app roles are rejected at login
ENTRA_REQUIRE_APP_ROLE=false
# Role given to new users when Entra sends no app role: viewer | operator | editor | admin
DEFAULT_ROLE=viewer
# Comma separated UPNs that are always admin (bootstrap)
BOOTSTRAP_ADMINS=

# ---- Database --------------------------------------------------------------
# password = classic user/password (local) | entra = Azure managed identity token
DB_AUTH=password
PGHOST=localhost
PGPORT=5432
PGDATABASE=cmdb
PGUSER=cmdb
PGPASSWORD=cmdb
# disable | require
PGSSLMODE=disable
# Client id of a user-assigned managed identity (leave empty for system-assigned)
AZURE_CLIENT_ID=
# Run pending migrations on startup
DB_MIGRATE_ON_START=true

# ---- Settings & notifications ---------------------------------------------
# Key for encrypting secrets stored in the app's settings (e.g. the SMTP password).
# Long random string, e.g. `openssl rand -base64 48`. Falls back to SESSION_SECRET if empty.
# Changing it makes stored secrets unreadable (they must be re-entered in Administration → Settings).
SETTINGS_ENCRYPTION_KEY=
# Run the daily warranty e-mail scheduler in this process (default: true, false in tests)
NOTIFICATIONS_SCHEDULER=true

# ---- Attachments (photos, plans, documents) -------------------------------
# database = file contents in PostgreSQL (development / small installations)
# azure-blob = Azure Blob Storage (production; managed identity via AZURE_CLIENT_ID)
STORAGE_DRIVER=database
# For azure-blob: account URL (managed identity) …
AZURE_STORAGE_ACCOUNT_URL=
# … or a connection string (e.g. Azurite: UseDevelopmentStorage=true)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=attachments
# Maximum size of one uploaded file
ATTACHMENT_MAX_MB=50

# ---- UI / maps ------------------------------------------------------------
# Header, login page and e-mails show BRAND_NAME above APP_NAME (e.g. your company name)
BRAND_NAME=Infrastruktur
APP_NAME=IT CMDB
BRAND_PRIMARY_COLOR="#2563eb"
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
